<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reconstructed project file — none existed before. Framework target and references
    were derived from the actual `using` statements in this folder: System.Web.Script.
    Serialization (JavaScriptSerializer) only exists in classic .NET Framework, so this
    stays net48, not net8.0. Needs both WPF (main window/UI) and WinForms
    (NotifyIcon/ContextMenuStrip for the system tray icon).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Tray icon (NotifyIcon/ContextMenuStrip in MainWindow.cs) needs WinForms
         alongside WPF - the old comment above claiming "WPF only" was stale. -->
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AutoProcessTwin</AssemblyName>
    <RootNamespace>AutoProcessTwin</RootNamespace>
    <ApplicationIcon>..\AppIcon.ico</ApplicationIcon>
    <Product>AutoProcessTwin</Product>
    <Company>AutoProcessTwin</Company>
    <AssemblyTitle>AutoProcessTwin</AssemblyTitle>
    <Description>Background activity recorder and local morning briefing.</Description>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- Without this, the SDK silently generates its own default manifest and
         discards app.manifest (it lives one directory up, so it was never
         auto-detected) - the PerMonitorV2 DPI-awareness declaration below was
         never actually being embedded into the built exe. Verified by grepping
         the compiled binary for "PerMonitorV2": absent before this fix. Without
         it, WPF falls back to System-DPI-aware behavior, which renders blurry/
         incorrectly scaled when the window is on a monitor at non-100% scaling
         or is dragged between monitors of different scaling. -->
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <!-- ProtectedData/DataProtectionScope (CryptoHelper.cs) live in System.Security.dll,
         a separate Framework assembly from System.Security.Cryptography's core types. -->
    <Reference Include="System.Security" />
  </ItemGroup>

  <!--
    Onboarding wizard illustration (local-designer skill, 100% local SVG rendered
    with sharp - see ../assets/onboarding/meta.json - not Bloom/generative AI).
    Embedded as a plain assembly manifest resource (LogicalName matches the
    -resource:...,onboarding-illustration.png flag in build\app\build.cmd, the
    real build script - this project is raw csc.exe, not MSBuild, so a WPF
    <Resource>/pack://application:,,, URI would silently do nothing there),
    loaded via Assembly.GetManifestResourceStream in OnboardingWizard.cs. The
    800x475 source lives alongside it for future regeneration but is not
    embedded here.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\assets\onboarding\onboarding-illustration.png">
      <LogicalName>onboarding-illustration.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
